// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  roomMembers RoomMember[]

  @@map("users")
}

model Room {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  members RoomMember[]
  widgets Widget[]

  @@map("rooms")
}

model RoomMember {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  roomId   String    @map("room_id")
  role     String    @default("member")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  expenseShares    ExpenseShare[]
  tasksCreated     Task[]        @relation("TaskCreatedBy")
  tasksAssigned    Task[]        @relation("TaskAssignedTo")
  mapPoints        MapPoint[]
  notes            Note[]
  chatMessages     ChatMessage[]

  @@unique([userId, roomId])
  @@map("room_members")
}

model Widget {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  type      String
  name      String
  settings  Json?

  room Room @relation(fields: [roomId], references: [id])

  expenses     Expense[]
  tasks        Task[]
  mapPoints    MapPoint[]
  notes        Note[]
  chatMessages ChatMessage[]

  @@unique([roomId, type])
  @@map("widgets")
}

model Expense {
  id          String   @id @default(uuid())
  widgetId    String   @map("widget_id")
  payerId     String   @map("payer_id")
  amount      Decimal
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  widget Widget @relation(fields: [widgetId], references: [id])
  shares ExpenseShare[]

  @@map("expenses")
}

model ExpenseShare {
  id           String   @id @default(uuid())
  expenseId    String   @map("expense_id")
  roomMemberId String   @map("room_member_id")
  amountOwed   Decimal  @map("amount_owed")
  isPaid       Boolean  @default(false) @map("is_paid")
  createdAt    DateTime @default(now()) @map("created_at")

  expense    Expense    @relation(fields: [expenseId], references: [id])
  roomMember RoomMember @relation(fields: [roomMemberId], references: [id])

  @@map("expense_shares")
}

model Task {
  id             String   @id @default(uuid())
  widgetId       String   @map("widget_id")
  createdById    String   @map("created_by_id")
  assignedToId   String   @map("assigned_to_id")
  status         String   @default("pending")
  title          String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  widget     Widget     @relation(fields: [widgetId], references: [id])
  createdBy  RoomMember @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedTo RoomMember @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  @@map("tasks")
}

model MapPoint {
  id           String   @id @default(uuid())
  widgetId     String   @map("widget_id")
  roomMemberId String   @map("room_member_id")
  lat          Float
  lng          Float
  title        String
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  widget     Widget     @relation(fields: [widgetId], references: [id])
  roomMember RoomMember @relation(fields: [roomMemberId], references: [id])

  @@map("map_points")
}

model Note {
  id           String   @id @default(uuid())
  widgetId     String   @map("widget_id")
  roomMemberId String   @map("room_member_id")
  text         String
  createdAt    DateTime @default(now()) @map("created_at")

  widget     Widget     @relation(fields: [widgetId], references: [id])
  roomMember RoomMember @relation(fields: [roomMemberId], references: [id])

  @@map("notes")
}

model ChatMessage {
  id           String   @id @default(uuid())
  widgetId     String   @map("widget_id")
  roomMemberId String   @map("room_member_id")
  text         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  widget     Widget     @relation(fields: [widgetId], references: [id])
  roomMember RoomMember @relation(fields: [roomMemberId], references: [id])

  @@map("chat_messages")
}